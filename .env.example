# GitHub API Token for serverless product storage
# Generate a fine-grained Personal Access Token at:
# https://github.com/settings/personal-access-tokens
# Required permission: Contents (read and write) on the wholesale-catalog repo
GITHUB_TOKEN=ghp_your_token_here

# Repository details (defaults are pre-filled for KTC)
GITHUB_REPO_OWNER=kamakhyatrandingco-design
GITHUB_REPO_NAME=wholesale-catalog
GITHUB_BRANCH=main

# Admin master PIN (default: 63506265)
ADMIN_PIN=63506265
