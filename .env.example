# 1. GitHub API Configuration (for serverless catalog storage on Netlify/Vercel)
# Generate a Personal Access Token (PAT) with "Contents" read/write scope:
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPO_OWNER=kamakhyatrandingco-design
GITHUB_REPO_NAME=wholesale-catalog
GITHUB_BRANCH=main
GITHUB_COMMITTER_NAME=hariomjoshi45
GITHUB_COMMITTER_EMAIL=harijoshi215@gmail.com

# 2. GitHub OAuth (Optional: for Admin GitHub login flow)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 3. Admin Security & PIN Authentication
# Master Admin PIN for portal access (default: 63506265)
ADMIN_PIN=63506265
# Secret salt for signing stateless recovery OTPs
ADMIN_SECRET=ktc-admin-key-63506265

# 4. Storefront & Business Info
NEXT_PUBLIC_SHOP_NAME="Kamakhya Trading Co"
NEXT_PUBLIC_WHATSAPP_NUMBER="916350626582"

# 5. AI Virtual Try-On Studio (Optional)
# Hugging Face token for remote GPU IDM-VTON model inference (falls back to local neural studio renderer)
HUGGINGFACE_TOKEN=
